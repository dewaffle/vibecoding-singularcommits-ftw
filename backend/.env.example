# Copy this file to .env and fill in real values when you have them.
# The app works with NO keys set at all — it just uses mock data instead.

# Gemini (Google AI Studio) API key
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Maps / Distance Matrix API key (optional — mocked if empty)
GOOGLE_MAPS_API_KEY=

# Port for the backend server
PORT=3001

# Set to "true" to force mock mode even if keys are present (useful for demos)
FORCE_MOCK=false
